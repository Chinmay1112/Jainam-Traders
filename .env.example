# ==============================================================================
# JAINAM TRADERS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL (Use http://localhost:3002 or http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Safe for browser client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION (FOR "CONTINUE WITH GOOGLE")
# ------------------------------------------------------------------------------
# Note: Google OAuth client credentials MUST be configured in:
# 1. Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
#    Authorized redirect URI: https://your-project-id.supabase.co/auth/v1/callback
# 2. Supabase Dashboard -> Authentication -> Providers -> Google
#    Paste Client ID and Client Secret there.
# DO NOT paste Google Client Secret here or in client-side code!

# ------------------------------------------------------------------------------
# PRODUCTION EMAIL & CUSTOM SMTP PROVIDER (FOR "GET OTP ON EMAIL")
# ------------------------------------------------------------------------------
# Supabase Email OTP requires custom SMTP configured in:
# Supabase Dashboard -> Project Settings -> Authentication -> SMTP Settings
#
# Supported providers: Resend, SendGrid, Mailgun, AWS SES, or custom SMTP server.
# Sender Identity: jainamtraders82@gmail.com
# Sender Name: Jainam Traders
#
# If configuring external SMTP microservice or webhook:
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_production_smtp_password_never_commit
SMTP_SENDER_EMAIL=jainamtraders82@gmail.com
SMTP_SENDER_NAME=Jainam Traders
# Set to 'true' once custom SMTP is active in your live Supabase project:
SUPABASE_SMTP_CONFIGURED=false

# ------------------------------------------------------------------------------
# ADMIN BOOTSTRAP & SECURITY (STAFF PORTAL ONLY)
# ------------------------------------------------------------------------------
# Secure secret used for staff/admin session token signatures
ADMIN_BOOTSTRAP_SECRET=your_admin_bootstrap_secret
ADMIN_INITIAL_EMAIL=owner@jainamtraders.com
CRON_SECRET=your_cron_secret

# ------------------------------------------------------------------------------
# AI CUSTOMER ASSISTANT
# ------------------------------------------------------------------------------
AI_ASSISTANT_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# ------------------------------------------------------------------------------
# NOTIFICATIONS & COMMUNICATION INTEGRATIONS
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
STORE_WHATSAPP_NUMBER=
STORE_CONTACT_PHONE=
STORE_CONTACT_EMAIL=contact@jainamtraders.com

# ------------------------------------------------------------------------------
# WEB PUSH & MOBILE NOTIFICATIONS (PWA / VAPID)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
