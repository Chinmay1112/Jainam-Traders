# ==============================================================================
# JAINAM TRADERS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Project URL from Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Safe for client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# ADMIN BOOTSTRAP & SECURITY
# ------------------------------------------------------------------------------
# Secure token or secret used for initial store owner / admin bootstrap
ADMIN_BOOTSTRAP_SECRET=jt_bootstrap_admin_secret_change_in_production_2026
ADMIN_INITIAL_EMAIL=owner@jainamtraders.com

# ------------------------------------------------------------------------------
# AI CUSTOMER ASSISTANT
# ------------------------------------------------------------------------------
# OpenAI / Gemini / Anthropic API Key for customer support chatbot tool calling
AI_ASSISTANT_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# ------------------------------------------------------------------------------
# NOTIFICATIONS & COMMUNICATION INTEGRATIONS
# ------------------------------------------------------------------------------
# WhatsApp Business Cloud API / Provider details (for order updates)
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
STORE_WHATSAPP_NUMBER=+919876543210

# Store Contact Information (Defaults if not configured in DB)
STORE_CONTACT_PHONE=+919876543210
STORE_CONTACT_EMAIL=contact@jainamtraders.com

# ------------------------------------------------------------------------------
# WEB PUSH & MOBILE NOTIFICATIONS (PWA / VAPID)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
